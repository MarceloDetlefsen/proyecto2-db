<Layouts.app flash={@flash} current_scope={@current_scope}>

  <%!-- HERO BANNER --%>
  <div class="rounded-box border p-8 mb-8 flex items-center justify-between" style="background-color: #f1f5eb; border-color: #c8d4a0;">
    <div>
      <p style="font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: #97a77d; margin-bottom: 8px;">Est. 2026 · Guatemala</p>
      <h1 style="font-family: Georgia, serif; font-size: 2.5rem; font-weight: 700; color: #385404; line-height: 1.1; margin-bottom: 12px;">
        Discos &<br/>Vinilos
      </h1>
      <p style="color: #6a7a54; font-size: 14px; letter-spacing: 1px;">Gestión de inventario, ventas y clientes</p>
      <div class="flex gap-3 mt-6">
        <a href="/inventario" class="btn btn-primary btn-sm">Ver Inventario</a>
        <a href="/ventas" class="btn btn-sm" style="background-color: #e2e8d5; border-color: #c8d4a0; color: #385404;">Nueva Venta</a>
      </div>
    </div>
    <div style="flex-shrink: 0;">
      <div style="width: 120px; height: 120px; border-radius: 50%; background: repeating-radial-gradient(circle, #2a3a1a 0px, #2a3a1a 2px, #f1f5eb 2px, #f1f5eb 4px); border: 3px solid #97a77d; position: relative;">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 32px; height: 32px; border-radius: 50%; background-color: #b8c280; border: 2px solid #97a77d;"></div>
      </div>
    </div>
  </div>

  <%!-- ESTADÍSTICAS --%>
  <div class="grid grid-cols-4 gap-4 mb-8">
    <div class="rounded-box border p-5 text-center" style="background-color: #f7fbf6; border-color: #c8d4a0;">
      <p style="font-family: Georgia, serif; font-size: 2rem; font-weight: 700; color: #385404;">50</p>
      <p style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #97a77d; margin-top: 4px;">Productos</p>
    </div>
    <div class="rounded-box border p-5 text-center" style="background-color: #f7fbf6; border-color: #c8d4a0;">
      <p style="font-family: Georgia, serif; font-size: 2rem; font-weight: 700; color: #385404;">25</p>
      <p style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #97a77d; margin-top: 4px;">Artistas</p>
    </div>
    <div class="rounded-box border p-5 text-center" style="background-color: #f7fbf6; border-color: #c8d4a0;">
      <p style="font-family: Georgia, serif; font-size: 2rem; font-weight: 700; color: #385404;">25</p>
      <p style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #97a77d; margin-top: 4px;">Ventas</p>
    </div>
    <div class="rounded-box border p-5 text-center" style="background-color: #f7fbf6; border-color: #c8d4a0;">
      <p style="font-family: Georgia, serif; font-size: 2rem; font-weight: 700; color: #385404;">25</p>
      <p style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #97a77d; margin-top: 4px;">Clientes</p>
    </div>
  </div>

  <%!-- ACCESOS RÁPIDOS --%>
  <div class="mb-8">
    <p style="font-size: 10px; letter-spacing: 4px; text-transform: uppercase; color: #97a77d; margin-bottom: 16px; border-bottom: 1px solid #c8d4a0; padding-bottom: 8px;">— Accesos rápidos —</p>
    <div class="grid grid-cols-2 gap-4">
      <a href="/inventario" class="rounded-box border p-6 flex items-start gap-4 transition-all hover:shadow-md" style="background-color: #f7fbf6; border-color: #c8d4a0; text-decoration: none;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background-color: #e2e8d5; border: 1px solid #c8d4a0; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <span style="font-size: 18px;">🎵</span>
        </div>
        <div>
          <p style="font-family: Georgia, serif; font-size: 15px; font-weight: 700; color: #385404; margin-bottom: 4px;">Inventario</p>
          <p style="font-size: 12px; color: #97a77d;">Gestiona productos, álbumes y stock disponible</p>
        </div>
      </a>
      <a href="/ventas" class="rounded-box border p-6 flex items-start gap-4 transition-all hover:shadow-md" style="background-color: #f7fbf6; border-color: #c8d4a0; text-decoration: none;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background-color: #e2e8d5; border: 1px solid #c8d4a0; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <span style="font-size: 18px;">🧾</span>
        </div>
        <div>
          <p style="font-family: Georgia, serif; font-size: 15px; font-weight: 700; color: #385404; margin-bottom: 4px;">Ventas</p>
          <p style="font-size: 12px; color: #97a77d;">Registra y consulta el historial de compras</p>
        </div>
      </a>
      <a href="/clientes" class="rounded-box border p-6 flex items-start gap-4 transition-all hover:shadow-md" style="background-color: #f7fbf6; border-color: #c8d4a0; text-decoration: none;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background-color: #e2e8d5; border: 1px solid #c8d4a0; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <span style="font-size: 18px;">👥</span>
        </div>
        <div>
          <p style="font-family: Georgia, serif; font-size: 15px; font-weight: 700; color: #385404; margin-bottom: 4px;">Clientes</p>
          <p style="font-size: 12px; color: #97a77d;">Administra la base de clientes de la tienda</p>
        </div>
      </a>
      <a href="/reportes" class="rounded-box border p-6 flex items-start gap-4 transition-all hover:shadow-md" style="background-color: #f7fbf6; border-color: #c8d4a0; text-decoration: none;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background-color: #e2e8d5; border: 1px solid #c8d4a0; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <span style="font-size: 18px;">📊</span>
        </div>
        <div>
          <p style="font-family: Georgia, serif; font-size: 15px; font-weight: 700; color: #385404; margin-bottom: 4px;">Reportes</p>
          <p style="font-size: 12px; color: #97a77d;">Consultas avanzadas y reportes de ventas</p>
        </div>
      </a>
    </div>
  </div>

  <%!-- ÁLBUMES RECIENTES --%>
  <div>
    <p style="font-size: 10px; letter-spacing: 4px; text-transform: uppercase; color: #97a77d; margin-bottom: 16px; border-bottom: 1px solid #c8d4a0; padding-bottom: 8px;">— Catálogo destacado —</p>
    <div class="grid grid-cols-4 gap-4">
      <%= for {titulo, artista, genero, precio} <- [
        {"Loveless", "My Bloody Valentine", "Shoegaze", "$35.00"},
        {"Pink Moon", "Nick Drake", "Folk", "$26.00"},
        {"Deathconsciousness", "Have a Nice Life", "Ambient", "$40.00"},
        {"Homogenic", "Björk", "Electronic", "$33.00"}
      ] do %>
        <div class="rounded-box border p-4" style="background-color: #f7fbf6; border-color: #c8d4a0;">
          <div style="width: 50px; height: 50px; border-radius: 50%; background: repeating-radial-gradient(circle, #2a3a1a 0px, #2a3a1a 1.5px, #f1f5eb 1.5px, #f1f5eb 3px); border: 2px solid #c8d4a0; margin-bottom: 12px; position: relative;">
            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 12px; height: 12px; border-radius: 50%; background-color: #b8c280;"></div>
          </div>
          <p style="font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #97a77d; margin-bottom: 2px;">{genero}</p>
          <p style="font-family: Georgia, serif; font-size: 13px; font-weight: 700; color: #385404; line-height: 1.3; margin-bottom: 2px;">{titulo}</p>
          <p style="font-size: 11px; color: #97a77d; margin-bottom: 8px;">{artista}</p>
          <p style="font-size: 14px; font-weight: 700; color: #385404;">{precio}</p>
        </div>
      <% end %>
    </div>
  </div>

</Layouts.app>