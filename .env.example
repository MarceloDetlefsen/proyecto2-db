# ── Base de datos ─────────────────────────────────────────────────────────────
DB_USER=proy2
DB_PASSWORD=secret
DB_NAME=tienda_albumes_prod

# ── Phoenix ───────────────────────────────────────────────────────────────────
# Host público donde corre la app (sin http://)
PHX_HOST=localhost

# Puerto expuesto por el contenedor
PORT=4000

# Clave secreta para producción (dev.exs ya tiene la suya para desarrollo local).
# Generar una nueva con: mix phx.gen.secret
SECRET_KEY_BASE=REEMPLAZAR_CON_RESULTADO_DE_mix_phx.gen.secret

# ── Release ───────────────────────────────────────────────────────────────────
RELEASE_COOKIE=heritage_records_cookie
